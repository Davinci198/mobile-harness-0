<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        The manifest contract (PluginContract):
          - capabilities meta-data: which plugin capabilities this APK claims;
          - an exported tool-host service behind ACTION_TOOL_HOST: the entry
            point Mobile Harness binds to from its own process.
    -->
    <application
        android:allowBackup="false"
        android:label="MH Plugin Sample">

        <meta-data
            android:name="com.jarves.mh.plugin.capabilities"
            android:value="tools" />

        <meta-data
            android:name="com.jarves.mh.plugin.entry_point"
            android:value="com.jarves.mh.sampleplugin.SampleToolHostService" />

        <service
            android:name="com.jarves.mh.sampleplugin.SampleToolHostService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.jarves.mh.plugin.ACTION_TOOL_HOST" />
            </intent-filter>
        </service>
    </application>
</manifest>
